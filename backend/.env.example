DATABASE_URL=mysql+asyncmy://USER:PASSWORD@localhost:3306/yii2basic?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=сгенерируй-openssl-rand-hex-32
JWT_EXPIRE_MIN=720
INVITE_ENCRYPTION_KEY=сгенерируй-python-cryptography-fernet-key
# Расширение (§10): папка с manifest.json/background.js/... на сервере + публичный base бэка
# (вшивается в zip как SERVER и host_permissions; токен не вшиваем — вводит человек)
EXTENSION_DIR=/var/www/wb/wb_extension/extension
EXT_PUBLIC_BASE=http://31.130.204.146:3000
# Локальный кэш фото WB: папка с файлами .webp (робот images_worker).
# Пусто = <корень проекта>/wb_images
WB_IMAGES_DIR=/var/www/wb/wb_images
# Сколько дней хранить фото, которое больше не встречается в источниках
# (начальное значение; дальше меняется в интерфейсе /competitor/images)
WB_IMAGES_TTL_DAYS=180

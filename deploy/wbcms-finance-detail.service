[Unit]
Description=wbcms finance detail sync (sales-reports/detailed -> detail_by_period, daily 01:00)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/wb/wbcms-py
EnvironmentFile=/var/www/wb/wbcms-py/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/wb/wbcms-py/.venv/bin/python backend/workers/finance_detail_sync.py --days 3

# wbcms timers admin: www-data управляет ТОЛЬКО своими таймерами, без пароля.
# sudo НЕ поддерживает wildcard в аргументах команды -> каждый юнит перечислен явно.
# Файл ОБЯЗАН быть в LF (без CRLF) — иначе visudo: "garbage at end of line".
# Поставить: cp deploy/wbcms-timers.sudoers /etc/sudoers.d/wbcms-timers && chmod 440 /etc/sudoers.d/wbcms-timers && visudo -c

www-data ALL=(root) NOPASSWD: /bin/systemctl enable --now wbcms-commission-tariffs.timer
www-data ALL=(root) NOPASSWD: /bin/systemctl disable --now wbcms-commission-tariffs.timer
www-data ALL=(root) NOPASSWD: /bin/systemctl restart wbcms-commission-tariffs.timer
www-data ALL=(root) NOPASSWD: /bin/systemctl start wbcms-commission-tariffs.service
www-data ALL=(root) NOPASSWD: /usr/bin/tee /etc/systemd/system/wbcms-commission-tariffs.timer.d/override.conf

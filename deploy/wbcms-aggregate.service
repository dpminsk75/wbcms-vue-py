[Unit]
Description=wbcms aggregate sync (OLAP cubes, daily 01:30)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/wb/wbcms-py
EnvironmentFile=/var/www/wb/wbcms-py/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/wb/wbcms-py/.venv/bin/python backend/workers/aggregate_sync.py --days 3

[Unit]
Description=wbcms feedback auto-reply (автоответы на отзывы WB, каждый час в :25)
After=network.target mysql.service

[Service]
# Память воркера: сервер 1 ГБ, базовая нагрузка ~765 МБ (mysqld, vite, legacy
# PHP). Воркер не должен съесть RAM, из-за которого OOM-killer убьёт mysqld —
# это ~40 минут офлайна (crash recovery + ожидание).
MemoryMax=300M
# Вес жертвы для OOM-killer'а: 1000 = умирать первым. Для mysqld выставлен
# OOMScoreAdjust=-1000 (systemctl edit mysql), поэтому при нехватке памяти
# умирает воркер, а база выживает. Воркер упадёт с 'oom-kill' и повторится
# по таймеру.
OOMScoreAdjust=1000
Type=oneshot
User=www-data
WorkingDirectory=/var/www/wb/wbcms-py
EnvironmentFile=/var/www/wb/wbcms-py/.env
Environment=PYTHONUNBUFFERED=1
# Порт PHP-крона `25 * * * * php yii wb-auto-reply/process` — каждый час в :25.
# Окно «вчера–сегодня» (--date-from -1 --date-to 0): в PHP было «сегодня», но
# отзыв, пришедший в 23:40 вчера, в окно «сегодня» не попадал и ждал вечно.
# Повторный ответ невозможен: is_auto_replied=1 / answer заполнен.
# --sync = узкий upsert отзывов за это окно (порт WbAutoReplyController::syncTodayFeedbacks).
# Не больше одного воркера одновременно: общий flock. Ждать до 15 мин (900 с),
# иначе пропустить этот запуск (exit 0) - повторится по таймеру.
ExecStart=/usr/bin/flock -w 900 -E 0 /tmp/wbcms-workers.lock /var/www/wb/wbcms-py/.venv/bin/python backend/workers/feedback_auto_reply.py --date-from -1 --date-to 0 --sync

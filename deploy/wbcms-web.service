[Unit]
Description=wbcms-web Vite
After=network.target wbcms-py.service
StartLimitIntervalSec=0

[Service]
User=www-data
WorkingDirectory=/var/www/wb/wbcms-web
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

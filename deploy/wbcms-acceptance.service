[Unit]
Description=wbcms acceptance sync (daily 05:15)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/wb/wbcms-py
EnvironmentFile=/var/www/wb/wbcms-py/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/wb/wbcms-py/.venv/bin/python backend/workers/acceptance_sync.py

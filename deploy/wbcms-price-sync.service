[Unit]
Description=wbcms price sync (discounts-prices -> wb_price_history, daily 06:00)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/wb/wbcms-py
EnvironmentFile=/var/www/wb/wbcms-py/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/wb/wbcms-py/.venv/bin/python backend/workers/price_sync.py
